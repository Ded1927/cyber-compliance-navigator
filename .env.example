# Docker Compose
COMPOSE_PROJECT_NAME=cyberlaw-navigator
APP_ENV=local

# PostgreSQL container
POSTGRES_DB=cyberlaw
POSTGRES_USER=cyberlaw
POSTGRES_PASSWORD=cyberlaw_password
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://cyberlaw:cyberlaw_password@db:5432/cyberlaw
CORS_ORIGINS=http://localhost,http://localhost:5173

# Auth and session cookies
# Change SECRET_KEY before any public deployment.
SECRET_KEY=change-me-in-production
AUTH_JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=cyberlaw_session
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=true

# Document generation
CISO_ORDER_TEMPLATE_PATH=/app/app/document_generation/templates/ciso_order_template.docx

# Edge proxy and frontend
NGINX_PORT=80
VITE_API_BASE_URL=/api
